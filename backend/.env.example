# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy (Nginx on EC2),
# so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=uptime
DB_PASSWORD=uptime_dev_password
DB_NAME=uptime

# JWT — use a long random string (at least 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Abuse limits
MAX_MONITORS_PER_USER=10
MAX_MONITORS_PER_HOST=3

# AWS (Day 2: scheduler + worker)
AWS_REGION=ap-south-1
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/uptime-monitor-checks
# Local dev only — on EC2 these are omitted and the instance's IAM role is used instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Open an incident (and send an email) after this many consecutive failed checks.
ALERT_FAILURE_THRESHOLD=3
# Must be a verified SES sender identity. Leave blank to disable email alerts (logged only).
ALERT_EMAIL_FROM=

# Turn off in tests / if you only want the API running.
ENABLE_SCHEDULER=true
ENABLE_WORKER=true
