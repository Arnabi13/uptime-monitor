# Production settings for the EC2 instance. On the server:
#   cp backend/.env.production.example backend/.env   then fill in the blanks.
# Never commit the real file.

NODE_ENV=production
PORT=3000

# Same origin as the API (Nginx serves both), so this only matters if you
# ever call the API from another site. Set to your public URL.
CORS_ORIGIN=http://<EC2-PUBLIC-IP>

# Number of proxies in front of the API: CloudFront → Nginx = 2.
# (Use 1 only if the site is reached directly through Nginx, without CloudFront.)
TRUST_PROXY=2

# PostgreSQL — runs in the "db" container. docker-compose.prod.yml reads these
# same three values to create the database, so they're defined only here.
DB_HOST=db
DB_PORT=5432
DB_USER=uptime
DB_NAME=uptime
# Long random value. Generate one:  openssl rand -hex 24
DB_PASSWORD=

# Generate:  openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

MAX_MONITORS_PER_USER=10
MAX_MONITORS_PER_HOST=3

# AWS. No access keys here: on EC2 the SDK gets short-lived credentials from
# the instance's IAM role (uptime-monitor-ec2-role) automatically.
AWS_REGION=ap-southeast-2
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/<account-id>/uptime-monitor-checks

ALERT_FAILURE_THRESHOLD=3
# Leave blank until SES is set up — alerts are then only logged.
ALERT_EMAIL_FROM=

ENABLE_SCHEDULER=true
ENABLE_WORKER=true

# Ship container logs to CloudWatch Logs (needs the instance role permissions in the README).
CLOUDWATCH_LOGS=false
